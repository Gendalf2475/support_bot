BOT_TOKEN=
SUPPORT_CHAT_ID=
DATABASE_URL=sqlite+aiosqlite:///data/majure_support_bot.db
LOG_LEVEL=INFO

# Telegram support
TELEGRAM_ENABLED=true

# Discord
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SUPPORT_MODE=dm

# Discord activity
DISCORD_ACTIVITY_ENABLED=true
DISCORD_ACTIVITY_TYPE=watching
DISCORD_ACTIVITY_NAME=Решает проблемы на MAJURE

# VK
VK_ENABLED=false
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_LONGPOLL_ENABLED=true

# Minecraft nickname autofill
MINECRAFT_NICKNAME_AUTOFILL_ENABLED=true

# MajureSupportAPI / Minecraft player lookup
MINECRAFT_API_ENABLED=false
MINECRAFT_API_TYPE=http
MINECRAFT_HTTP_API_BASE_URL=http://127.0.0.1:8085
MINECRAFT_HTTP_API_TOKEN=
MINECRAFT_HTTP_API_TIMEOUT=5
MINECRAFT_NICKNAME_CHECK_ENABLED=false
MINECRAFT_NICKNAME_CHECK_STRICT=false

# Ticket reminders
TICKET_REMINDER_ENABLED=true
TICKET_REMINDER_AFTER_HOURS=24
TICKET_REMINDER_INTERVAL_MINUTES=60
TICKET_CHECK_INTERVAL_MINUTES=10

# User reply reminder
USER_REPLY_REMINDER_ENABLED=true
USER_REPLY_REMINDER_AFTER_HOURS=25
USER_REPLY_REMINDER_INTERVAL_HOURS=24

# Ticket auto close
TICKET_AUTO_CLOSE_ENABLED=true
TICKET_AUTO_CLOSE_AFTER_DAYS=7
TICKET_AUTO_CLOSE_WARNING_ENABLED=true
TICKET_AUTO_CLOSE_WARNING_HOURS=24

# Channel failure notifications
CHANNEL_FAILURE_NOTIFY_ENABLED=true
CHANNEL_FAILURE_NOTIFY_COOLDOWN_MINUTES=30
